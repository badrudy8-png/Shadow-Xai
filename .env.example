# Default is local and credential-free
SHADOW_MODEL_PROVIDER=echo
SHADOW_MODEL_NAME=shadow-local
# For an OpenAI-compatible endpoint:
# SHADOW_MODEL_PROVIDER=openai-compatible
# SHADOW_MODEL_BASE_URL=https://example.invalid/v1
# SHADOW_MODEL_API_KEY=replace-me
SHADOW_MODEL_TIMEOUT=30
SHADOW_MEMORY_PATH=shadow_xai.db
SHADOW_PERSONALITY=helpful
SHADOW_MAX_AGENT_STEPS=5
